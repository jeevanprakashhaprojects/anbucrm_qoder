# ── Copy this file to .env and fill in real values ─────────────────────────────
# NEVER commit the real .env. The .gitignore in this folder already blocks it.

# Port your host exposes (Hostinger usually injects this automatically)
PORT=3000

# ── Razorpay Dashboard → Settings → API Keys ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# ── Razorpay Dashboard → Settings → Webhooks ───────────────────────────────────
# The secret you typed when creating the webhook (NOT the key secret above)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Firebase Console → Project settings → Service accounts ─────────────────────
# Click "Generate new private key", then paste the JSON as ONE LINE below.
# Replace every newline with \n and wrap the whole thing in double quotes.
FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"anbucrm-2026\", ...}"

# Alternative to the above: upload serviceAccount.json next to server.js and set
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# ── Realtime Database location (already detected for this project) ─────────────
FIREBASE_DATABASE_URL=https://anbucrm-2026-default-rtdb.asia-southeast1.firebasedatabase.app

# ── Plan shown in checkout ─────────────────────────────────────────────────────
PLAN_AMOUNT_INR=500
CURRENCY=INR
BUSINESS_NAME=AnbuCRM
PLAN_DESCRIPTION=AnbuCRM monthly plan
