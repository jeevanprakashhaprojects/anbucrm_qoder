PORT=3000
NODE_ENV=production

# Firebase Admin SDK — paste the entire service-account JSON as a single line
# (run: cat service-account.json | jq -c . )
FIREBASE_SERVICE_ACCOUNT_JSON={}
FIREBASE_WEB_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Razorpay (test keys first — https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Flutter app origin (CORS)
ALLOWED_ORIGINS=https://anbucrm.com,https://www.anbucrm.com
